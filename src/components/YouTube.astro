---
interface Props { id: string; title: string; large?: boolean }
const { id, title, large = false } = Astro.props;
---

<button class:list={["yt", { large }]} type="button" data-yt={id} aria-label={`Play: ${title}`}>
  <img src={`https://i.ytimg.com/vi/${id}/${large ? "maxresdefault" : "hqdefault"}.jpg`} alt="" loading="lazy" decoding="async" />
  <span class="play" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
  </span>
</button>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>("button[data-yt]").forEach((b) => {
      b.addEventListener("click", () => {
        const f = document.createElement("iframe");
        f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
        f.title = b.getAttribute("aria-label")?.replace(/^Play: /, "") ?? "YouTube video";
        f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
        f.allowFullscreen = true;
        f.className = "yt-frame";
        b.replaceWith(f);
      }, { once: true });
    });
  });
</script>

<style is:global>
  .yt, .yt-frame { aspect-ratio: 16 / 9; width: 100%; border-radius: var(--r); border: 0; background: var(--paper-2); }
  .yt { position: relative; padding: 0; cursor: pointer; overflow: hidden; box-shadow: var(--shadow); }
  .yt img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85); transition: transform 1s var(--ease), filter 0.6s; }
  .yt:hover img { transform: scale(1.035); filter: saturate(1); }
  .yt .play {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; color: var(--ink);
    background: rgba(255, 255, 255, 0.72); -webkit-backdrop-filter: blur(12px) saturate(1.6); backdrop-filter: blur(12px) saturate(1.6);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 10px 30px -10px rgba(0, 0, 0, 0.35);
    transition: transform 0.5s var(--ease);
  }
  .yt.large .play { width: 76px; height: 76px; }
  .yt:hover .play { transform: scale(1.08); }
  .yt .play svg { margin-left: 3px; }
</style>
