---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
// Replace src/assets/portrait.jpg with a larger original (≥ 600×600) for sharper retina rendering.
import portrait from "../assets/portrait.jpg";
import { profile, sections } from "../data/site";
import { getCueDays, md, tint } from "../lib/cues";

const days = await getCueDays();
const latest = days.slice(0, 6).flatMap((d) => d.items.map((i) => ({ ...i, label: d.label }))).filter((i) => i.tag).slice(0, 3);
---

<Base fluid="full">
  <section class="hero">
    <div class="wrap">
      <div class="hero-top">
        <div>
          <p class="eyebrow" data-reveal>Engineer · Pianist · Researcher</p>
          <h1 class="name" data-reveal style="--d:80ms">Rebecca Ceccatelli</h1>
        </div>
        <figure class="portrait" data-reveal style="--d:260ms">
          <span class="halo" aria-hidden="true"></span>
          <Image src={portrait} alt="Rebecca Ceccatelli, smiling, in New York with the Manhattan Bridge behind her" width={240} height={240} loading="eager" />
        </figure>
      </div>
      <div class="hero-foot">
        <p class="lede" data-reveal style="--d:200ms">{profile.intro}</p>
      </div>
    </div>
    <a class="scroll" href="#explore" aria-label="Scroll to the sections">
      <svg viewBox="0 0 14 40" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 1v37M1.5 32.5 7 38l5.5-5.5"/></svg>
    </a>
  </section>

  <section class="section-tight" id="explore">
    <div class="wrap">
      <ol class="index">
        {sections.map((s, i) => (
          <li data-reveal style={`--d:${i * 70}ms`}>
            <a href={s.href} class="row">
              <span class="n num">0{i + 1}</span>
              <span class="t">{s.title}</span>
              <span class="b muted">{s.blurb}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head" data-reveal>
        <div>
          <p class="eyebrow">Lately, in Thoughts &amp; Cues</p>
          <h2 class="h2" style="margin-top:14px">Things worth <span class="ital">passing on</span></h2>
        </div>
        <a class="link-arrow" href="/cues/">The whole log <span>→</span></a>
      </div>
      <div class="latest">
        {latest.map((i, k) => (
          <article class="card glass cue" data-reveal style={`--d:${k * 90}ms`}>
            <div class="meta"><span class="chip" data-tint={tint(i.tag!)}>{i.tag}</span><span class="small muted">{i.label}</span></div>
            <p class="clamp" set:html={md(i.text)} />
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: 92svh; display: flex; align-items: center; padding: 140px 0 clamp(48px, 8vw, 96px); }
  .name {
    font-family: var(--serif); font-size: clamp(2.6rem, 5.5vw, 4.4rem); line-height: 1.05; letter-spacing: -0.01em;
    margin: 20px 0 clamp(24px, 3.5vw, 36px); padding-right: 0.05em; width: fit-content;
    background: linear-gradient(100deg, #5e4130, #a5784c); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-top { display: flex; align-items: center; justify-content: space-between; gap: 32px; }

  /* Portrait in a slowly morphing liquid frame */
  .portrait { position: relative; margin: 0 clamp(0px, 4vw, 64px) 0 0; width: clamp(150px, 19vw, 240px); aspect-ratio: 1; flex: none; }
  .portrait :global(img), .halo { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 47% 53% 42% 58% / 55% 44% 56% 45%; animation: morph 14s ease-in-out infinite; }
  .portrait :global(img) { object-fit: cover; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.6), 0 30px 60px -28px rgba(90, 60, 30, 0.4); }
  .halo { inset: -14px; width: auto; height: auto; background: conic-gradient(from 0deg, #ecdcbf, #c9d1b8, #d9b98c, #c8d2dc, #e5c2b8, #ecdcbf); filter: blur(18px); opacity: 0.75; animation: morph 14s ease-in-out infinite reverse, spin 22s linear infinite; }
  @keyframes morph {
    0%, 100% { border-radius: 47% 53% 42% 58% / 55% 44% 56% 45%; }
    33% { border-radius: 58% 42% 55% 45% / 45% 58% 42% 55%; }
    66% { border-radius: 42% 58% 47% 53% / 58% 47% 53% 42%; }
  }
  @keyframes spin { to { rotate: 360deg; } }
  @media (max-width: 640px) {
    .hero-top { flex-direction: column-reverse; align-items: flex-start; gap: 28px; }
    .portrait { width: 132px; margin: 0 0 0 6px; }
  }
  .hero-foot { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 24px 48px; }
  /* scroll cue: a fine line with a chevron, drifting gently */
  .scroll { position: absolute; left: 50%; bottom: clamp(20px, 4vh, 40px); translate: -50% 0; display: grid; place-items: center; width: 44px; height: 64px; color: var(--muted); transition: color 0.4s; }
  .scroll:hover { color: var(--ink); }
  .scroll svg { width: 14px; height: 40px; animation: drift 2.6s var(--ease) infinite; }
  @keyframes drift { 0%, 100% { transform: translateY(-4px); opacity: 0.55; } 50% { transform: translateY(5px); opacity: 1; } }

  .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .index li { border-bottom: 1px solid var(--line); }
  .row {
    display: grid; grid-template-columns: 56px minmax(0, 1.1fr) minmax(0, 1.4fr) 32px; align-items: center; gap: 24px;
    padding: clamp(20px, 3vw, 34px) 8px; text-decoration: none; position: relative;
  }
  .row::before {
    content: ""; position: absolute; inset: 6px -8px; border-radius: var(--r); background: rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    opacity: 0; transform: scale(0.985); transition: opacity 0.5s var(--ease), transform 0.5s var(--ease); z-index: -1;
  }
  .row:hover::before { opacity: 1; transform: none; }
  .n { font-size: 0.8rem; color: var(--muted); }
  .t { font-family: var(--serif); font-size: clamp(1.9rem, 4vw, 3.1rem); line-height: 1; transition: transform 0.6s var(--ease); }
  .row:hover .t { transform: translateX(8px); font-style: italic; }
  .b { font-size: 0.98rem; max-width: 34em; }
  .go { font-size: 1.3rem; transition: transform 0.5s var(--ease); justify-self: end; }
  .row:hover .go { transform: translateX(4px) rotate(-45deg); }
  @media (max-width: 760px) {
    .row { grid-template-columns: 36px 1fr 24px; gap: 6px 14px; }
    .b { grid-column: 2 / 3; font-size: 0.9rem; }
    .go { grid-row: 1; grid-column: 3; }
  }

  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 36px; }
  .latest { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .cue .meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .cue p { color: var(--ink-2); font-size: 0.97rem; }
  .clamp { display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden; }
  .cue :global(a) { color: var(--accent); }
</style>
