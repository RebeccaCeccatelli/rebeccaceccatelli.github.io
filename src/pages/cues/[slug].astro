---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes", (n) => !n.data.draft);
  return notes.map((n) => ({ params: { slug: n.id }, props: { note: n } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<Base title={note.data.title} description={note.data.summary} fluid="subtle">
  <article>
    <header class="page-head">
      <div class="wrap narrow">
        <a class="link-arrow small" href="/cues/"><span>←</span> Thoughts &amp; Cues</a>
        <p class="eyebrow" style="margin-top:36px">{note.data.tag} · {date}</p>
        <h1 class="h1">{note.data.title}</h1>
        <p class="lede">{note.data.summary}</p>
      </div>
    </header>
    <div class="wrap narrow prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .prose { font-size: 1.08rem; line-height: 1.75; color: var(--ink-2); padding-bottom: 40px; }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2) { font-family: var(--serif); font-size: 2rem; color: var(--ink); margin-top: 1.8em; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(img) { border-radius: var(--r); margin: 2em 0; }
  .prose :global(blockquote) { margin: 1.6em 0; padding-left: 20px; border-left: 2px solid var(--caramel); font-family: var(--serif); font-size: 1.4rem; line-height: 1.4; color: var(--ink); }
</style>
